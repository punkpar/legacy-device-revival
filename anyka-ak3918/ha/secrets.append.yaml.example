# Example Home Assistant secrets for the Anyka PTZ integration.
#
# Copy the line into your real /config/secrets.yaml and set the value.
# NEVER commit the real key.

# Shared key for the keyed PTZ/IR/motion CGI. Find it on the camera at
# /etc/jffs2/ptz.key  (it is ALSO the value served by the keyed wrapper).
anyka_ptz_key: "REPLACE_ME"
